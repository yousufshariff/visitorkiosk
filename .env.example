# Server
DATABASE_URL=postgres://user:password@host:5432/kiosk
S3_BUCKET=your-private-bucket
S3_REGION=us-west-2
# AWS credentials come from the default provider chain (env, role, profile)
# Comma-separated SHA-256 hashes of allowed kiosk keys (see docs/deploy-and-smoke-test.md)
KIOSK_KEY_HASHES=
SLACK_FALLBACK_WEBHOOK=
TEAMS_FALLBACK_WEBHOOK=
PORT=3000

# Build time only (baked into the kiosk bundle)
VITE_KIOSK_KEY=
